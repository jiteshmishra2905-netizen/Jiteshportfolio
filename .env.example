# ==============================================================================
# MECHANICAL ENGINEERING PORTFOLIO - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Public URL of the portfolio (used for sitemap and canonical SEO metadata)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact Form Email Dispatch (Optional)
# If left blank, contact submissions will be safely logged to the server terminal.
# To receive live emails from the contact form:
# 1. Sign up for free at https://resend.com
# 2. Generate an API Key
# 3. Paste your key below and rename this file to .env.local
RESEND_API_KEY=re_your_api_key_here

# Your personal email address where you want to receive contact inquiries
CONTACT_NOTIFICATION_EMAIL=your.real.email@example.com
